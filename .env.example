# BERNADA.ID — Environment Variables
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# JANGAN commit file `.env` (sudah dikecualikan di .gitignore).

# Mode aplikasi: development | production
NODE_ENV=development

# Port server
PORT=3000

# Origin yang diizinkan untuk CORS (pisahkan dengan koma untuk lebih dari satu).
# '*' berarti izinkan semua (hanya untuk development).
CORS_ORIGIN=*

# Koneksi PostgreSQL.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Bikin database dulu: npm run db:create, lalu jalankan migrasi: npm run migrate
DATABASE_URL=postgresql://bernada:bernada@localhost:5432/bernada

# Secret untuk menandatangani JWT access token.
# WAJIB diisi nilai acak & rahasia pada mode production.
JWT_SECRET=ganti-dengan-string-acak-panjang

# Masa berlaku access token (lihat https://github.com/vercel/ms)
JWT_ACCESS_EXPIRES=15m

# Masa berlaku refresh token (hari)
REFRESH_TOKEN_EXPIRY_DAYS=30
