{
  "name": "bernada",
  "version": "1.3.0",
  "description": "BERNADA.ID — Digital Wedding Invitation Platform",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env database/migrate.js",
    "db:create": "node --env-file-if-exists=.env database/create-db.js",
    "test:health": "node --env-file-if-exists=.env scripts/health-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.0"
  }
}
